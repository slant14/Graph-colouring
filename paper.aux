\@writefile{lot}{\contentsline {table}{\numberline {4}{\ignorespaces Reduction validated by simulation. Each graph is run at $k=\chi $ and $k=\chi {-}1$; all $18$ simulated instances reproduce the brute-force oracle's $\alpha (G')$ exactly, and every $k=\chi $ case decodes to a proper coloring. The $k=\chi {-}1$ rows (omitted for space) likewise match, correctly reporting non-colorability. Petersen exceeds the $16$-slot classical-simulation wall.}}{18}{table.4}\protected@file@percent }
\newlabel{tab:sim}{{4}{18}{Reduction validated by simulation. Each graph is run at $k=\chi $ and $k=\chi {-}1$; all $18$ simulated instances reproduce the brute-force oracle's $\indep (G')$ exactly, and every $k=\chi $ case decodes to a proper coloring. The $k=\chi {-}1$ rows (omitted for space) likewise match, correctly reporting non-colorability. Petersen exceeds the $16$-slot classical-simulation wall}{table.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Classical-simulation cost is exponential in the number of slots $nk$ (semilog axis): sub-second to $\approx 12$ slots, $\approx 55$\,s at the $2^{16}$ wall. The next subsection removes this wall without enlarging any single solve.}}{18}{figure.5}\protected@file@percent }
\newlabel{fig:wall}{{5}{18}{Classical-simulation cost is exponential in the number of slots $nk$ (semilog axis): sub-second to $\approx 12$ slots, $\approx 55$\,s at the $2^{16}$ wall. The next subsection removes this wall without enlarging any single solve}{figure.5}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {9.5}The DIMACS Mycielski Benchmark}{18}{subsection.9.5}\protected@file@percent }
\newlabel{sec:dimacs}{{9.5}{18}{The DIMACS Mycielski Benchmark}{subsection.9.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Certified decomposition. The whole color-choice instance ($nk$ slots) is classically unsimulable, yet the largest device piece is always $\le 13$ atoms. All verdicts are correct: proper colorings where colorable, a sound non-colorability proof for the odd cycle.}}{19}{table.5}\protected@file@percent }
\newlabel{tab:decomp}{{5}{19}{Certified decomposition. The whole color-choice instance ($nk$ slots) is classically unsimulable, yet the largest device piece is always $\le 13$ atoms. All verdicts are correct: proper colorings where colorable, a sound non-colorability proof for the odd cycle}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Whole-instance $nk$ (orange, would require a $2^{nk}$ vector) versus the largest piece actually simulated (green) under decomposition. The dashed line is the $16$-slot monolithic wall; every device solve stays comfortably below it while $nk$ reaches $192$.}}{19}{figure.6}\protected@file@percent }
\newlabel{fig:decomp}{{6}{19}{Whole-instance $nk$ (orange, would require a $2^{nk}$ vector) versus the largest piece actually simulated (green) under decomposition. The dashed line is the $16$-slot monolithic wall; every device solve stays comfortably below it while $nk$ reaches $192$}{figure.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces DIMACS Mycielski benchmark, run through the full decomposition${}+{}$Rydberg pipeline. Both directions on \texttt  {myciel3} certify $\chi =4$ exactly; the infeasible row is a sound, exhaustive non-colorability proof ($158$ device calls, $82$\,s). All verdicts agree with the known chromatic numbers, and no single device solve exceeds $11$ atoms.}}{19}{table.6}\protected@file@percent }
\newlabel{tab:dimacs}{{6}{19}{DIMACS Mycielski benchmark, run through the full decomposition${}+{}$Rydberg pipeline. Both directions on \texttt {myciel3} certify $\chi =4$ exactly; the infeasible row is a sound, exhaustive non-colorability proof ($158$ device calls, $82$\,s). All verdicts agree with the known chromatic numbers, and no single device solve exceeds $11$ atoms}{table.6}{}}
