\@writefile{lot}{\contentsline {table}{\numberline {6}{\ignorespaces DIMACS Mycielski benchmark, run through the full decomposition${}+{}$Rydberg pipeline. Both directions on \texttt  {myciel3} certify $\chi =4$ exactly; the infeasible row is a sound, exhaustive non-colorability proof ($158$ device calls, $82$\,s). All verdicts agree with the known chromatic numbers, and no single device solve exceeds $11$ atoms.}}{18}{table.6}\protected@file@percent }
\newlabel{tab:dimacs}{{6}{18}{DIMACS Mycielski benchmark, run through the full decomposition${}+{}$Rydberg pipeline. Both directions on \texttt {myciel3} certify $\chi =4$ exactly; the infeasible row is a sound, exhaustive non-colorability proof ($158$ device calls, $82$\,s). All verdicts agree with the known chromatic numbers, and no single device solve exceeds $11$ atoms}{table.6}{}}
