\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Classical-simulation cost is exponential in the number of slots $nk$ (semilog axis): sub-second to $\approx 12$ slots, $\approx 55$\,s at the $2^{16}$ wall. The next subsection removes this wall without enlarging any single solve.}}{17}{figure.5}\protected@file@percent }
\newlabel{fig:wall}{{5}{17}{Classical-simulation cost is exponential in the number of slots $nk$ (semilog axis): sub-second to $\approx 12$ slots, $\approx 55$\,s at the $2^{16}$ wall. The next subsection removes this wall without enlarging any single solve}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {5}{\ignorespaces Certified decomposition. The whole color-choice instance ($nk$ slots) is classically unsimulable, yet the largest device piece is always $\le 13$ atoms. All verdicts are correct: proper colorings where colorable, a sound non-colorability proof for the odd cycle.}}{17}{table.5}\protected@file@percent }
\newlabel{tab:decomp}{{5}{17}{Certified decomposition. The whole color-choice instance ($nk$ slots) is classically unsimulable, yet the largest device piece is always $\le 13$ atoms. All verdicts are correct: proper colorings where colorable, a sound non-colorability proof for the odd cycle}{table.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Whole-instance $nk$ (orange, would require a $2^{nk}$ vector) versus the largest piece actually simulated (green) under decomposition. The dashed line is the $16$-slot monolithic wall; every device solve stays comfortably below it while $nk$ reaches $192$.}}{17}{figure.6}\protected@file@percent }
\newlabel{fig:decomp}{{6}{17}{Whole-instance $nk$ (orange, would require a $2^{nk}$ vector) versus the largest piece actually simulated (green) under decomposition. The dashed line is the $16$-slot monolithic wall; every device solve stays comfortably below it while $nk$ reaches $192$}{figure.6}{}}
